# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ============================================
# Base de données PostgreSQL
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=telecom
DATABASE_PASSWORD=telecom_secret
DATABASE_NAME=telecom_tickets
DATABASE_URL=postgresql://telecom:telecom_secret@localhost:5432/telecom_tickets
DATABASE_MAX_CONNECTIONS=500

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Support public — utiliser des valeurs distinctes des JWT internes.
PUBLIC_SESSION_SECRET=replace-with-a-distinct-secret-of-at-least-32-characters
PUBLIC_SESSION_ISSUER=telecom-public-support
PUBLIC_SESSION_AUDIENCE=telecom-public-bff
PUBLIC_SUPPORT_CONTACT_HASH_SECRET=replace-with-a-distinct-hmac-secret-of-at-least-32-characters
# Format: version:clé-base64-32-octets,version:clé-base64-32-octets
PUBLIC_SUPPORT_MASTER_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
PUBLIC_SUPPORT_MASTER_KEY_VERSION=1
PUBLIC_SUPPORT_SECRET_GRACE_MINUTES=15
PUBLIC_SUPPORT_DEVICE_TRUST_DAYS=90
PUBLIC_SUPPORT_DEVICE_POLICY_VERSION=1
PUBLIC_SUPPORT_OTP_TTL_SECONDS=600
PUBLIC_SUPPORT_OTP_MAX_ATTEMPTS=5
PUBLIC_SUPPORT_OTP_RESEND_SECONDS=60
PUBLIC_SESSION_TTL_SECONDS=900
PUBLIC_ASSERTION_AUDIENCE=telecom-integration-assertion
PUBLIC_ASSERTION_MAX_AGE_SECONDS=120
PUBLIC_BOOTSTRAP_TTL_SECONDS=120
# Omettre pour utiliser support_session/support_iframe en dev et les variantes __Host- en production.
# Origines exactes du portail public qui ouvre le WebSocket, pas les sites hôtes de l'iframe.
# PUBLIC_WS_COOKIE_NAME=__Host-support_session,__Host-support_iframe_session
PUBLIC_SUPPORT_ORIGINS=http://localhost:3005,http://support.localhost
# Dev/test. En production, omettre la variable pour utiliser __Host-access-token
# ou definir exactement la meme valeur __Host-* que le BFF frontend.
AUTH_ACCESS_COOKIE_NAME=access_token

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@telecom-tickets.local
SMTP_SECURE=false

# ============================================
# Upload de fichiers
# ============================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE=10485760
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
CLAMAV_MAX_FILE_SIZE=10485760
ATTACHMENT_QUARANTINE_RETENTION_HOURS=24

# ============================================
# Throttler (Rate Limiting)
# ============================================
THROTTLE_TTL=900000
THROTTLE_LIMIT=1000
THROTTLE_AUTH_TTL=3600000
THROTTLE_AUTH_LIMIT=20

# ============================================
# Application — URLs & Identité
# ============================================
APP_NAME="Helpdesk Telecom"
APP_URL=http://localhost:3000
LOGO_URL=http://localhost:3000/logo.png
LOGIN_URL=http://localhost:3000/login
DASHBOARD_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
REPORT_DOWNLOAD_SECRET=change-me-report-download-secret-min-32-chars
REPORT_DOWNLOAD_TTL_SECONDS=604800
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug

# ============================================
# OpenTelemetry
# ============================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=telecom-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces

# ============================================
# Observabilité — Grafana
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST=localhost
GRAFANA_PORT=3001

# ============================================
# Observabilité — Prometheus
# ============================================
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=15

# ============================================
# Observabilité — Loki
# ============================================
LOKI_HOST=loki
LOKI_PORT=3100
LOKI_HTTP_PORT=3100
LOKI_GRPC_PORT=9096
LOKI_RETENTION_DAYS=30

# ============================================
# Observabilité — Tempo
# ============================================
TEMPO_HOST=tempo
TEMPO_PORT=3200
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_RETENTION_HOURS=48

# ============================================
# Observabilité — Promtail
# ============================================
PROMTAIL_HTTP_PORT=9080

# ============================================
# Hôtes Docker (pour les configs internes)
# ============================================
API_HOST=api
API_PORT=3000
ALERTMANAGER_HOST=alertmanager
ALERTMANAGER_PORT=9093
NGINX_API_UPSTREAM=api:3000

# ============================================
# Mailpit (SMTP de test)
# ============================================
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ============================================
# Nginx
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# Alertmanager
# ============================================
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
ALERTMANAGER_SMTP_HOST=mailpit
ALERTMANAGER_SMTP_PORT=1025
ALERTMANAGER_SMTP_FROM=alertmanager@telecom-tickets.local
ALERTMANAGER_DEFAULT_EMAIL=ops@telecom-tickets.local
ALERTMANAGER_CRITICAL_EMAIL=oncall@telecom-tickets.local
ALERTMANAGER_WARNING_EMAIL=ops@telecom-tickets.local
# Pour WhatsApp : remplacer par vos propres identifiants CallMeBot
ALERTMANAGER_WHATSAPP_PHONE=22967391224
ALERTMANAGER_WHATSAPP_APIKEY=7499427
ALERTMANAGER_WHATSAPP_WEBHOOK_URL=https://webhook.example.com/whatsapp

# ============================================
# PostgreSQL (Docker Compose)
# ============================================
POSTGRES_USER=telecom
POSTGRES_PASSWORD=telecom_secret
POSTGRES_DB=telecom_tickets

# ============================================
# Docker — Variables spécifiques au réseau Docker
# ============================================
# ⚠️  À utiliser UNIQUEMENT dans le fichier .env (pas .env.local).
#     Ces valeurs pointent vers les noms de service Docker,
#     pas vers localhost. Le .env normal contient localhost
#     pour le développement sans Docker.
DOCKER_DATABASE_URL=postgresql://telecom:telecom_secret@postgres:5432/telecom_tickets
DOCKER_REDIS_HOST=redis
DOCKER_REDIS_PORT=6379
DOCKER_REDIS_URL=redis://redis:6379
DOCKER_API_HOST=api
DOCKER_API_PORT=3000

# ============================================
# Application — Host public (pour les logs et URLs)
# ============================================
API_PUBLIC_HOST=localhost:3000
MAILPIT_WEB_PORT=8025
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =========================================================
# BullBoard (optionnel - pour la surveillance des queues)
# =========================================================
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=bullboard
# =========================================================
# Support public - intégration du portail/BFF
# =========================================================
# Clé publique de l'intégration autorisée (colonne public_key de support_integrations).
PUBLIC_SUPPORT_INTEGRATION_KEY=replace-with-the-integration-public-key
# Secret CSRF du BFF public-frontend (32+ caractères, partagé avec compose).
PUBLIC_BFF_CSRF_SECRET=replace-with-at-least-32-random-characters
# Cookies publics en HTTP local uniquement (false). Omettre en production HTTPS.
PUBLIC_COOKIE_SECURE=false
# Noms des cookies de session publics (portail, iframe widget).
PUBLIC_WS_COOKIE_NAME=support_session,support_iframe_session

# =========================================================
# Support public - Bot IA (DeepSeek / OpenAI-compatible)
# =========================================================
# Provider : deepseek (recommandé) ou openai-compatible. Inactif si absent.
PUBLIC_SUPPORT_BOT_PROVIDER=deepseek
# Clé API réelle - JAMAIS committée. Laissez vide pour garder le bot en repli formulaire.
PUBLIC_SUPPORT_BOT_API_KEY=sk-215d0319f41f47e6ae5771b075c0cf53
# Défauts automatiques : deepseek -> https://api.deepseek.com + deepseek-chat ;
# openai-compatible -> https://api.openai.com/v1 + gpt-4o-mini. Surcharges possibles :
PUBLIC_SUPPORT_BOT_BASE_URL=
PUBLIC_SUPPORT_BOT_MODEL=
PUBLIC_SUPPORT_BOT_MAX_TOKENS=800
PUBLIC_SUPPORT_BOT_TIMEOUT_MS=20000
PUBLIC_SUPPORT_BOT_DAILY_BUDGET=200
PUBLIC_SUPPORT_BOT_CIRCUIT_OPEN_AFTER=5
PUBLIC_SUPPORT_BOT_CIRCUIT_OPEN_MS=600000
PUBLIC_SUPPORT_BOT_PROMPT_VERSION=2026-08-v1
# =========================================================
# Rétention des données publiques (RGPD)
# =========================================================
# Jours d'inactivité avant anonymisation automatique du demandeur (aucun ticket ouvert).
PUBLIC_SUPPORT_RETENTION_INACTIVE_DAYS=395

# =========================================================
# Auth - résilience Redis (contrôle de révocation JWT)
# =========================================================
# true (défaut logique) : si Redis est indisponible, un JWT valide reste accepté
# (jetons courts) au lieu de faire tomber l'API en 500. Mettre false pour fail-closed.
AUTH_REDIS_BLACKLIST_FAIL_OPEN=true

# ---- Keycloak SSO (phase 7) ----
AUTH_PROVIDER=local
KEYCLOAK_ISSUER=http://localhost:8080/realms/telecom
# URL JWKS interne (nom de service Docker) si l'API tourne en conteneur :
# sinon l'URL publique ${KEYCLOAK_ISSUER}/protocol/openid-connect/certs est utilisée.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/telecom/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Admin@1234
KEYCLOAK_REDIRECT_URI=http://localhost:3001/api/auth/keycloak/callback
PUBLIC_PORTAL_ORIGIN=http://localhost:3005
