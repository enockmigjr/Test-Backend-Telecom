{{> base
  subject=subject
  accentColor=accentColor
  footerText=footerText
  body="
<p class='email-eyebrow' style='color:#b45309'>⚠️ Attention SLA</p>
<h1 class='email-title'>Échéance SLA proche · {{ticketNumber}}</h1>

<p class='email-text'>Bonjour <strong>{{recipientName}}</strong>,</p>
<p class='email-text'>
  Le délai de résolution pour le ticket ci-dessous arrive à échéance très prochainement.
</p>

<div class='email-alert alert-warn'>
  <p><strong>Délai imminent : moins de {{remainingMinutes}} minutes restantes</strong>
  Veuillez intervenir rapidement pour éviter une violation SLA.</p>
</div>

<div class='email-highlight' style='border-left-color:#f59e0b'>
  <p class='email-highlight-label'>Ticket concerné</p>
  <p class='email-highlight-value'>{{ticketNumber}} — {{ticketTitle}}</p>
</div>

<table class='info-table' role='presentation' cellpadding='0' cellspacing='8'>
  <tr>
    <td class='info-cell'>
      <p class='info-cell-label'>Échéance de résolution</p>
      <p class='info-cell-value' style='color:#d97706'>{{slaDueAt}}</p>
    </td>
    <td class='info-cell'>
      <p class='info-cell-label'>Temps restant</p>
      <p class='info-cell-value'>{{remainingMinutes}} minutes</p>
    </td>
  </tr>
</table>

<div class='btn-wrap'>
  <a href='{{ticketUrl}}' class='btn-primary'>Traiter le ticket</a>
</div>
"
}}