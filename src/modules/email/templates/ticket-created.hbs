{{> base
  subject=subject
  accentColor=accentColor
  footerText=footerText
  body="
<p class='email-eyebrow'>Nouveau Ticket</p>
<h1 class='email-title'>Votre ticket a été créé avec succès</h1>

<p class='email-text'>Bonjour,</p>
<p class='email-text'>
  Votre ticket a été enregistré sous le numéro de suivi unique <strong>{{ticketNumber}}</strong>.
</p>

<div class='email-highlight'>
  <p class='email-highlight-label'>Détails du ticket</p>
  <p class='email-highlight-value'>{{ticketNumber}} — {{title}}</p>
</div>

<table class='info-table' role='presentation' cellpadding='0' cellspacing='8'>
  <tr>
    <td class='info-cell'>
      <p class='info-cell-label'>Catégorie</p>
      <p class='info-cell-value'>{{category}}</p>
    </td>
    <td class='info-cell'>
      <p class='info-cell-label'>Priorité</p>
      <p class='info-cell-value'><span class='badge badge-blue'>{{priority}}</span></p>
    </td>
  </tr>
</table>

<p class='email-text'>
  Nos équipes de support technique ont été notifiées et prennent en charge votre demande. Vous recevrez une notification par email dès qu'un agent mettra à jour ce ticket.
</p>

<div class='btn-wrap'>
  <a href='{{ticketUrl}}' class='btn-primary'>Suivre mon ticket</a>
</div>
"
}}