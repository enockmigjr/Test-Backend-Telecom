{{#> base subject=subject accentColor=accentColor footerText=footerText}}
<p class='email-eyebrow'>Rapports & Statistiques</p>
<h1 class='email-title'>Rapport Hebdomadaire · Semaine {{weekNumber}}</h1>

<p class='email-text'>
  Voici le résumé opérationnel des indicateurs de performance (KPI) pour la période du <strong>{{periodStart}}</strong> au <strong>{{periodEnd}}</strong>.
</p>

<table class='info-table' role='presentation' cellpadding='0' cellspacing='8'>
  <tr>
    <td class='info-cell'>
      <p class='info-cell-label'>Tickets créés</p>
      <p class='info-cell-value'>{{totalCreated}}</p>
    </td>
    <td class='info-cell'>
      <p class='info-cell-label'>Tickets résolus</p>
      <p class='info-cell-value' style='color:#16a34a'>{{totalResolved}}</p>
    </td>
  </tr>
  <tr>
    <td class='info-cell'>
      <p class='info-cell-label'>Tickets en cours</p>
      <p class='info-cell-value' style='color:#d97706'>{{totalOpen}}</p>
    </td>
    <td class='info-cell'>
      <p class='info-cell-label'>Violations SLA</p>
      <p class='info-cell-value' style='color:#dc2626'>{{slaBreaches}}</p>
    </td>
  </tr>
  <tr>
    <td class='info-cell'>
      <p class='info-cell-label'>Conformité SLA</p>
      <p class='info-cell-value' style='font-weight:bold'>{{complianceRate}}%</p>
    </td>
    <td class='info-cell'>
      <p class='info-cell-label'>Moyenne de résolution</p>
      <p class='info-cell-value'>{{avgResolutionMinutes}} min</p>
    </td>
  </tr>
</table>

<div class='btn-wrap' style='margin-bottom:10px'>
  <a href='{{downloadUrl}}' class='btn-primary'>Telecharger le PDF</a>
</div>
<div class='btn-wrap'>
  <a href='{{dashboardUrl}}' class='btn-primary' style='background-color:#555555'>Consulter le Dashboard</a>
</div>

<p class='email-text' style='font-size:12px;color:#888;margin-top:20px'>
  Rapport généré automatiquement le {{generatedAt}}.
</p>
{{/base}}