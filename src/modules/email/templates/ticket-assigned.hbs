{{> base
  subject=subject
  accentColor=accentColor
  footerText=footerText
  body="
<p class='email-eyebrow'>Assignation</p>
<h1 class='email-title'>Un ticket vous a été assigné</h1>

<p class='email-text'>Bonjour <strong>{{assigneeName}}</strong>,</p>
<p class='email-text'>
  <strong>{{supervisorName}}</strong> vous a assigné le ticket ci-dessous.
  Merci de le traiter dans les délais SLA impartis.
</p>

<div class='email-highlight'>
  <p class='email-highlight-label'>Ticket assigné</p>
  <p class='email-highlight-value'>{{ticketNumber}} — {{ticketTitle}}</p>
</div>

<table class='info-table' role='presentation' cellpadding='0' cellspacing='8'>
  <tr>
    <td class='info-cell'>
      <p class='info-cell-label'>Catégorie</p>
      <p class='info-cell-value'>{{category}}</p>
    </td>
    <td class='info-cell'>
      <p class='info-cell-label'>Sévérité/Priorité</p>
      <p class='info-cell-value'>{{severity}}</p>
    </td>
  </tr>
  <tr>
    <td class='info-cell'>
      <p class='info-cell-label'>Département</p>
      <p class='info-cell-value'>{{department}}</p>
    </td>
    <td class='info-cell'>
      <p class='info-cell-label'>SLA résolution</p>
      <p class='info-cell-value'>{{slaDueAt}}</p>
    </td>
  </tr>
</table>

{{#if description}}
<p class='email-text' style='font-size:13px;color:#666'>
  <strong>Description :</strong><br>{{description}}
</p>
{{/if}}

<div class='btn-wrap'>
  <a href='{{ticketUrl}}' class='btn-primary'>Prendre en charge</a>
</div>
"
}}