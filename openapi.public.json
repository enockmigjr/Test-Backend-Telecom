{
  "components": {
    "schemas": {
      "ApiErrorDetail": {
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ApiErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "correlationId": {
                "format": "uuid",
                "type": "string"
              },
              "details": {
                "oneOf": [
                  {
                    "items": {
                      "$ref": "#/components/schemas/ApiErrorDetail"
                    },
                    "type": "array"
                  },
                  {
                    "additionalProperties": true,
                    "type": "object"
                  }
                ]
              },
              "message": {
                "type": "string"
              },
              "timestamp": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "correlationId",
              "timestamp"
            ],
            "type": "object"
          },
          "success": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      },
      "ApiPaginatedResponse": {
        "properties": {
          "data": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          },
          "statusCode": {
            "maximum": 299,
            "minimum": 200,
            "type": "integer"
          },
          "success": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "statusCode",
          "data",
          "meta"
        ],
        "type": "object"
      },
      "ApiSuccessResponse": {
        "properties": {
          "data": {
            "nullable": true
          },
          "message": {
            "type": "string"
          },
          "statusCode": {
            "maximum": 299,
            "minimum": 200,
            "type": "integer"
          },
          "success": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "statusCode",
          "data"
        ],
        "type": "object"
      },
      "ConfirmPublicTicketDto": {
        "properties": {
          "confirmed": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "confirmed"
        ],
        "type": "object"
      },
      "ConsumeBootstrapDto": {
        "properties": {
          "code": {
            "description": "Code opaque extrait du fragment puis envoyé en POST",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "ConsumeEmailVerificationDto": {
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code"
        ],
        "type": "object"
      },
      "CreatePublicCommentDto": {
        "properties": {
          "content": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      },
      "CreatePublicConversationDto": {
        "properties": {
          "serviceKey": {
            "example": "internet-fixe",
            "maxLength": 80,
            "type": "string"
          }
        },
        "type": "object"
      },
      "PaginationMeta": {
        "properties": {
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ],
        "type": "object"
      },
      "PublicHandoffDto": {
        "properties": {
          "reason": {
            "maxLength": 500,
            "type": "string"
          }
        },
        "type": "object"
      },
      "RequestEmailVerificationDto": {
        "properties": {
          "email": {
            "example": "client@example.com",
            "type": "string"
          },
          "integrationKey": {
            "description": "Clé publique de l'intégration",
            "type": "string"
          }
        },
        "required": [
          "integrationKey",
          "email"
        ],
        "type": "object"
      },
      "SavePublicTicketDraftDto": {
        "properties": {
          "categoryId": {
            "format": "uuid",
            "type": "string"
          },
          "customerAccountNumber": {
            "maxLength": 100,
            "type": "string"
          },
          "description": {
            "maxLength": 10000,
            "minLength": 10,
            "type": "string"
          },
          "impact": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "type": "string"
          },
          "serviceKey": {
            "maxLength": 80,
            "type": "string"
          },
          "title": {
            "maxLength": 255,
            "minLength": 5,
            "type": "string"
          },
          "urgency": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "type": "string"
          }
        },
        "required": [
          "categoryId",
          "title",
          "description",
          "impact",
          "urgency"
        ],
        "type": "object"
      },
      "UpdatePublicPreferencesDto": {
        "properties": {
          "displayName": {
            "maxLength": 160,
            "type": "string"
          },
          "locale": {
            "example": "fr",
            "maxLength": 16,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "integrationAssertion": {
        "bearerFormat": "IntegrationAssertion",
        "description": "Assertion signée à usage unique d'une intégration",
        "scheme": "bearer",
        "type": "http"
      },
      "integrationKey": {
        "in": "header",
        "name": "x-integration-key",
        "type": "apiKey"
      },
      "publicSession": {
        "bearerFormat": "PublicSession",
        "description": "Session courte du demandeur public",
        "scheme": "bearer",
        "type": "http"
      },
      "trustedDevice": {
        "in": "header",
        "name": "x-trusted-device",
        "type": "apiKey"
      }
    }
  },
