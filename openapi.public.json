        "parameters": [],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccessResponse"
                }
              }
            },
            "description": ""
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Erreur standardisée."
          }
        },
        "security": [
          {
            "integrationAssertion": []
          }
        ],
        "summary": "Échanger une assertion signée contre une session publique",
        "tags": [
          "Support public - identité"
        ],
        "x-api-audience": "public-support"
      }
    },
