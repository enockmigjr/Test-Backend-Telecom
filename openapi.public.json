{
  "components": {
    "schemas": {
      "ApiErrorDetail": {
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ApiErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "correlationId": {
                "format": "uuid",
                "type": "string"
              },
              "details": {
                "oneOf": [
                  {
                    "items": {
                      "$ref": "#/components/schemas/ApiErrorDetail"
                    },
                    "type": "array"
                  },
                  {
                    "additionalProperties": true,
                    "type": "object"
                  }
                ]
              },
              "message": {
                "type": "string"
              },
              "timestamp": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "correlationId",
              "timestamp"
            ],
            "type": "object"
          },
          "success": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      },
      "ApiSuccessResponse": {
        "properties": {
          "data": {
            "nullable": true
          },
          "message": {
            "type": "string"
          },
          "statusCode": {
            "maximum": 299,
            "minimum": 200,
            "type": "integer"
          },
          "success": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "statusCode",
          "data"
        ],
        "type": "object"
      },
      "ConsumeBootstrapDto": {
        "properties": {
          "code": {
            "description": "Code opaque extrait du fragment puis envoyé en POST",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "ConsumeEmailVerificationDto": {
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code"
        ],
        "type": "object"
      },
      "RequestEmailVerificationDto": {
        "properties": {
          "email": {
            "example": "client@example.com",
            "type": "string"
          },
          "integrationKey": {
            "description": "Clé publique de l'intégration",
            "type": "string"
          }
        },
        "required": [
          "integrationKey",
          "email"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "integrationAssertion": {
        "bearerFormat": "IntegrationAssertion",
        "description": "Assertion signée à usage unique d'une intégration",
        "scheme": "bearer",
        "type": "http"
      },
      "integrationKey": {
        "in": "header",
        "name": "x-integration-key",
        "type": "apiKey"
      },
      "publicSession": {
        "bearerFormat": "PublicSession",
        "description": "Session courte du demandeur public",
        "scheme": "bearer",
        "type": "http"
      },
      "trustedDevice": {
        "in": "header",
        "name": "x-trusted-device",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Contrat borné du portail public, du widget et des adaptateurs de support.",
    "title": "Telecom Public Support API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
